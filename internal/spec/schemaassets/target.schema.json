{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronicle.dev/schemas/target.schema.json",
  "title": "ChronicleGate Target",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "chronicle.dev/v1alpha1"},
    "kind": {"const": "Target"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {
      "type": "object", "additionalProperties": false, "required": ["databaseSchemaVersion", "services"],
      "properties": {
        "databaseSchemaVersion": {"type": "string", "minLength": 1},
        "services": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/service"}}
      }
    }
  },
  "$defs": {
    "metadata": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "description": {"type": "string"}}},
    "duration": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(ns|us|µs|ms|s|m|h)([0-9]+(ns|us|µs|ms|s|m|h))*$"},
    "image": {"type": "string", "pattern": "^(?:[^@[:space:]]+@sha256:[0-9a-f]{64}|sha256:[0-9a-f]{64})$"},
    "service": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "image", "command", "args", "environment", "secretEnvironment", "health", "probe", "resources", "dependencies"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "image": {"$ref": "#/$defs/image"},
        "command": {"type": "array", "items": {"type": "string"}},
        "args": {"type": "array", "items": {"type": "string"}},
        "environment": {"type": "object", "propertyNames": {"pattern": "^[A-Z][A-Z0-9_]*$"}, "additionalProperties": {"type": "string"}},
        "secretEnvironment": {"type": "object", "propertyNames": {"pattern": "^[A-Z][A-Z0-9_]*$"}, "additionalProperties": {"type": "string", "minLength": 1}},
        "health": {
          "type": "object", "additionalProperties": false, "required": ["type", "timeout", "interval"],
          "properties": {"type": {"enum": ["http", "tcp", "probe"]}, "path": {"type": "string"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "timeout": {"$ref": "#/$defs/duration"}, "interval": {"$ref": "#/$defs/duration"}}
        },
        "probe": {
          "type": "object", "additionalProperties": false, "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"}, "protocolVersion": {"type": "string"},
            "commitMode": {"enum": ["manual_sync", "automatic", "none"]},
            "maxControlledInFlight": {"type": "integer", "minimum": 0},
            "checkpoints": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "logicalClock": {"type": "boolean"}
          }
        },
        "resources": {
          "type": "object", "additionalProperties": false, "required": ["cpus", "memoryBytes", "pids"],
          "properties": {"cpus": {"type": "number", "exclusiveMinimum": 0}, "memoryBytes": {"type": "integer", "minimum": 67108864}, "pids": {"type": "integer", "minimum": 16}}
        },
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
