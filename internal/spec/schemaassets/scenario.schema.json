{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronicle.dev/schemas/scenario.schema.json",
  "title": "ChronicleGate Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "chronicle.dev/v1alpha1"},
    "kind": {"const": "Scenario"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "clock", "events", "steps", "quiescence", "observations", "invariants", "normalization", "limits"],
      "properties": {
        "seed": {"type": "object"},
        "clock": {"type": "object", "additionalProperties": false, "properties": {"start": {"type": "string", "format": "date-time"}}},
        "events": {"type": "object", "additionalProperties": {"$ref": "#/$defs/cloudEvent"}},
        "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
        "quiescence": {"$ref": "#/$defs/quiescence"},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
        "invariants": {"type": "array", "items": {"$ref": "#/$defs/invariant"}},
        "normalization": {"type": "array", "items": {"$ref": "#/$defs/normalization"}},
        "limits": {"$ref": "#/$defs/limits"},
        "comparison": {"$ref": "#/$defs/comparison"}
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "description": {"type": "string"}}
    },
    "duration": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(ns|us|µs|ms|s|m|h)([0-9]+(ns|us|µs|ms|s|m|h))*$"},
    "jsonPointer": {"type": "string", "pattern": "^(/([^~/]|~0|~1)*)*$"},
    "localPath": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|^[A-Za-z][A-Za-z0-9+.-]*:|(^|/)\\.\\.(/|$))"}},
    "cloudEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["specversion", "id", "source", "type", "subject", "time", "datacontenttype", "data"],
      "properties": {
        "specversion": {"const": "1.0"}, "id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1}, "time": {"type": "string", "format": "date-time"},
        "datacontenttype": {"const": "application/json"}, "data": {"type": "object"},
        "aggregateid": {"type": "string"}, "aggregateversion": {"type": "integer", "minimum": 0},
        "correlationid": {"type": "string"}, "causationid": {"type": "string"},
        "schemaversion": {"type": "string"}, "dataschema": {"$ref": "#/$defs/localPath"},
        "registry": {"$ref": "#/$defs/registry"}
      }
    },
    "registry": {
      "type": "object", "additionalProperties": false,
      "required": ["subject", "schemaType", "compatibility", "history"],
      "properties": {
        "subject": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "schemaType": {"const": "JSON"},
        "compatibility": {"enum": ["BACKWARD", "BACKWARD_TRANSITIVE", "FORWARD", "FORWARD_TRANSITIVE", "FULL", "FULL_TRANSITIVE"]},
        "history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/localPath"}}
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["service", "name", "eventId", "stepId", "occurrence"],
      "properties": {
        "service": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1},
        "eventId": {"type": "string", "minLength": 1}, "stepId": {"type": "string", "minLength": 1},
        "occurrence": {"type": "integer", "minimum": 1}
      }
    },
    "step": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "optional": {"type": "boolean"},
        "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "timeout": {"$ref": "#/$defs/duration"},
        "publish": {
          "type": "object", "additionalProperties": false, "required": ["event", "topic", "partition", "key"],
          "properties": {"event": {"type": "string"}, "topic": {"type": "string"}, "partition": {"type": "integer", "minimum": 0}, "key": {"type": "string"}}
        },
        "await": {
          "type": "object", "additionalProperties": false,
          "properties": {"condition": {"type": "string"}, "checkpoint": {"$ref": "#/$defs/checkpoint"}},
          "oneOf": [{"required": ["condition"]}, {"required": ["checkpoint"]}]
        },
        "stop": {"$ref": "#/$defs/serviceAction"}, "restart": {"$ref": "#/$defs/serviceAction"},
        "rewindOffset": {
          "type": "object", "additionalProperties": false, "required": ["service", "group", "topic", "partition", "toOffset"],
          "properties": {"service": {"type": "string"}, "group": {"type": "string"}, "topic": {"type": "string"}, "partition": {"type": "integer", "minimum": 0}, "toOffset": {"type": "integer", "minimum": 0}}
        },
        "armCheckpoint": {"$ref": "#/$defs/checkpoint"}, "releaseCheckpoint": {"$ref": "#/$defs/checkpoint"},
        "advanceClock": {"type": "object", "additionalProperties": false, "required": ["by"], "properties": {"by": {"$ref": "#/$defs/duration"}}},
        "observe": {"type": "object", "additionalProperties": false, "required": ["observation"], "properties": {"observation": {"type": "string"}}}
      },
      "oneOf": [
        {"required": ["publish"]}, {"required": ["await"]}, {"required": ["stop"]},
        {"required": ["restart"]}, {"required": ["rewindOffset"]}, {"required": ["armCheckpoint"]},
        {"required": ["releaseCheckpoint"]}, {"required": ["advanceClock"]}, {"required": ["observe"]}
      ]
    },
    "serviceAction": {"type": "object", "additionalProperties": false, "required": ["service"], "properties": {"service": {"type": "string", "minLength": 1}}},
    "quiescence": {
      "type": "object", "additionalProperties": false, "required": ["timeout", "stabilityWindow", "conditions"],
      "properties": {
        "timeout": {"$ref": "#/$defs/duration"}, "stabilityWindow": {"$ref": "#/$defs/duration"},
        "conditions": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "type"],
          "properties": {"id": {"type": "string"}, "type": {"enum": ["groupLagZero", "probeIdle", "checkpointsClear", "outboxEmpty", "effectsIdle", "terminalState"]}, "service": {"type": "string"}, "group": {"type": "string"}, "state": {"type": "string"}}
        }}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "sql": {"type": "object", "additionalProperties": false, "required": ["queryFile", "orderBy", "mode"], "properties": {"queryFile": {"$ref": "#/$defs/localPath"}, "orderBy": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "mode": {"enum": ["ordered", "set", "multiset", "keyed"]}, "keyPointer": {"$ref": "#/$defs/jsonPointer"}}},
        "kafka": {"type": "object", "additionalProperties": false, "required": ["topic", "schemaFile", "partition", "startOffset", "endOffset", "mode"], "properties": {"topic": {"type": "string"}, "schemaFile": {"$ref": "#/$defs/localPath"}, "partition": {"type": "integer", "minimum": 0}, "startOffset": {"type": "integer", "minimum": 0}, "endOffset": {"type": "integer", "minimum": 0}, "mode": {"enum": ["ordered", "set", "multiset", "keyed"]}, "keyPointer": {"$ref": "#/$defs/jsonPointer"}, "nonsemanticHeaders": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
        "http": {"$ref": "#/$defs/httpObserver"}, "effects": {"$ref": "#/$defs/httpObserver"}
      },
      "oneOf": [{"required": ["sql"]}, {"required": ["kafka"]}, {"required": ["http"]}, {"required": ["effects"]}]
    },
    "httpObserver": {"type": "object", "additionalProperties": false, "required": ["service", "port", "path", "mode"], "properties": {"service": {"type": "string", "minLength": 1}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "path": {"type": "string", "pattern": "^/[^/].*$"}, "mode": {"enum": ["ordered", "set", "multiset", "keyed"]}, "keyPointer": {"$ref": "#/$defs/jsonPointer"}}},
    "invariant": {
      "type": "object", "additionalProperties": false, "required": ["id", "queryFile", "classification"],
      "properties": {"id": {"type": "string"}, "queryFile": {"$ref": "#/$defs/localPath"}, "classification": {"enum": ["SEMANTIC_REGRESSION", "SCHEMA_REGRESSION", "EXTERNAL_EFFECT_REGRESSION"]}}
    },
    "normalization": {
      "type": "object", "additionalProperties": false, "required": ["id", "observation", "type", "pointer"],
      "properties": {
        "id": {"type": "string"}, "observation": {"type": "string"},
        "type": {"enum": ["remove", "replace", "stableOrder", "numericTolerance", "timestamp"]},
        "pointer": {"$ref": "#/$defs/jsonPointer"}, "token": {"type": "string"},
        "keys": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "tolerance": {"type": "number", "minimum": 0}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxSteps", "maxEvents", "maxRunDuration", "confirmationAttempts", "minimizationTrials", "minimizationDuration"],
      "properties": {
        "maxSteps": {"type": "integer", "minimum": 1, "maximum": 10000},
        "maxEvents": {"type": "integer", "minimum": 1, "maximum": 100000},
        "maxRunDuration": {"$ref": "#/$defs/duration"},
        "confirmationAttempts": {"type": "integer", "minimum": 2, "maximum": 10},
        "minimizationTrials": {"type": "integer", "minimum": 1, "maximum": 10000},
        "minimizationDuration": {"$ref": "#/$defs/duration"}
      }
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "allowedTargetDifferences": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["pointer", "rationale"],
          "properties": {"pointer": {"$ref": "#/$defs/jsonPointer"}, "rationale": {"type": "string", "minLength": 1}}
        }}
      }
    }
  }
}
