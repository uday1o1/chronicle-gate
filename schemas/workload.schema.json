{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronicle.dev/schemas/workload.schema.json",
  "title": "ChronicleGate Workload",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "chronicle.dev/v1alpha1"},
    "kind": {"const": "Workload"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["events", "observations", "invariants", "normalization", "quiescence"],
      "properties": {
        "events": {"type": "object", "additionalProperties": {"$ref": "#/$defs/cloudEvent"}},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
        "invariants": {"type": "array", "items": {"$ref": "#/$defs/invariant"}},
        "normalization": {"type": "array", "items": {"$ref": "#/$defs/normalization"}},
        "quiescence": {"$ref": "#/$defs/quiescence"}
      }
    }
  },
  "$defs": {
    "metadata": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "description": {"type": "string"}}},
    "duration": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(ns|us|µs|ms|s|m|h)([0-9]+(ns|us|µs|ms|s|m|h))*$"},
    "pointer": {"type": "string", "pattern": "^(/([^~/]|~0|~1)*)*$"},
    "localPath": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|^[A-Za-z][A-Za-z0-9+.-]*:|(^|/)\\.\\.(/|$))"}},
    "cloudEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["specversion", "id", "source", "type", "subject", "time", "datacontenttype", "data"],
      "properties": {
        "specversion": {"const": "1.0"}, "id": {"type": "string"}, "source": {"type": "string"}, "type": {"type": "string"},
        "subject": {"type": "string"}, "time": {"type": "string", "format": "date-time"}, "datacontenttype": {"const": "application/json"},
        "data": {"type": "object"}, "aggregateid": {"type": "string"}, "aggregateversion": {"type": "integer", "minimum": 0},
        "correlationid": {"type": "string"}, "causationid": {"type": "string"}, "schemaversion": {"type": "string"}, "dataschema": {"$ref": "#/$defs/localPath"}, "registry": {"$ref": "#/$defs/registry"}
      }
    },
    "registry": {"type": "object", "additionalProperties": false, "required": ["subject", "schemaType", "compatibility", "history"], "properties": {"subject": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}, "schemaType": {"const": "JSON"}, "compatibility": {"enum": ["BACKWARD", "BACKWARD_TRANSITIVE", "FORWARD", "FORWARD_TRANSITIVE", "FULL", "FULL_TRANSITIVE"]}, "history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/localPath"}}}},
    "observation": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "sql": {"type": "object", "additionalProperties": false, "required": ["queryFile", "orderBy", "mode"], "properties": {"queryFile": {"$ref": "#/$defs/localPath"}, "orderBy": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "mode": {"enum": ["ordered", "set", "multiset", "keyed"]}, "keyPointer": {"$ref": "#/$defs/pointer"}}},
        "kafka": {"type": "object", "additionalProperties": false, "required": ["topic", "schemaFile", "partition", "startOffset", "endOffset", "mode"], "properties": {"topic": {"type": "string"}, "schemaFile": {"$ref": "#/$defs/localPath"}, "partition": {"type": "integer", "minimum": 0}, "startOffset": {"type": "integer", "minimum": 0}, "endOffset": {"type": "integer", "minimum": 0}, "mode": {"enum": ["ordered", "set", "multiset", "keyed"]}, "keyPointer": {"$ref": "#/$defs/pointer"}, "nonsemanticHeaders": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
        "http": {"$ref": "#/$defs/http"}, "effects": {"$ref": "#/$defs/http"}
      },
      "oneOf": [{"required": ["sql"]}, {"required": ["kafka"]}, {"required": ["http"]}, {"required": ["effects"]}]
    },
    "http": {"type": "object", "additionalProperties": false, "required": ["service", "port", "path", "mode"], "properties": {"service": {"type": "string", "minLength": 1}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "path": {"type": "string", "pattern": "^/[^/].*$"}, "mode": {"enum": ["ordered", "set", "multiset", "keyed"]}, "keyPointer": {"$ref": "#/$defs/pointer"}}},
    "invariant": {"type": "object", "additionalProperties": false, "required": ["id", "queryFile", "classification"], "properties": {"id": {"type": "string"}, "queryFile": {"$ref": "#/$defs/localPath"}, "classification": {"enum": ["SEMANTIC_REGRESSION", "SCHEMA_REGRESSION", "EXTERNAL_EFFECT_REGRESSION"]}}},
    "normalization": {
      "type": "object", "additionalProperties": false, "required": ["id", "observation", "type", "pointer"],
      "properties": {"id": {"type": "string"}, "observation": {"type": "string"}, "type": {"enum": ["remove", "replace", "stableOrder", "numericTolerance", "timestamp"]}, "pointer": {"$ref": "#/$defs/pointer"}, "token": {"type": "string"}, "keys": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "tolerance": {"type": "number", "minimum": 0}}
    },
    "quiescence": {
      "type": "object", "additionalProperties": false, "required": ["timeout", "stabilityWindow", "conditions"],
      "properties": {"timeout": {"$ref": "#/$defs/duration"}, "stabilityWindow": {"$ref": "#/$defs/duration"}, "conditions": {"type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "type"],
        "properties": {"id": {"type": "string"}, "type": {"enum": ["groupLagZero", "probeIdle", "checkpointsClear", "outboxEmpty", "effectsIdle", "terminalState"]}, "service": {"type": "string"}, "group": {"type": "string"}, "state": {"type": "string"}}
      }}}
    }
  }
}
