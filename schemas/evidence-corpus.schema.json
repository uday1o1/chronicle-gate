{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronicle.dev/schemas/evidence-corpus.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "semanticCases", "benchmarkCases"],
  "properties": {
    "schemaVersion": {"const": "chronicle.dev/evidence-corpus/v1alpha1"},
    "semanticCases": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {"$ref": "#/$defs/semanticCase"}
    },
    "benchmarkCases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/benchmarkCase"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^/\\\\][^\\\\]*$"},
    "role": {"enum": ["regression", "control"]},
    "semanticCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claimId", "role", "scenario", "baseline", "candidate", "expectedExit", "expectedClassification", "expectedSignature", "minimize"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "claimId": {"type": "string", "pattern": "^R[1-7](-control)?$"},
        "role": {"$ref": "#/$defs/role"},
        "scenario": {"$ref": "#/$defs/path"},
        "baseline": {"$ref": "#/$defs/path"},
        "candidate": {"$ref": "#/$defs/path"},
        "expectedExit": {"enum": [0, 2]},
        "expectedClassification": {"enum": ["PASS", "SEMANTIC_REGRESSION", "SCHEMA_REGRESSION", "EXTERNAL_EFFECT_REGRESSION"]},
        "expectedSignature": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]},
        "minimize": {"type": "boolean"}
      }
    },
    "benchmarkCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "workload", "baseline", "candidate", "expectedExit", "expectedClassification"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "role": {"$ref": "#/$defs/role"},
        "workload": {"$ref": "#/$defs/path"},
        "baseline": {"$ref": "#/$defs/path"},
        "candidate": {"$ref": "#/$defs/path"},
        "expectedExit": {"enum": [0, 2]},
        "expectedClassification": {"enum": ["PASS", "PERFORMANCE_REGRESSION"]}
      }
    }
  }
}
